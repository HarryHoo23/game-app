{
  "name": "afterhours-basketball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/physics-check.mjs && node scripts/lifecycle-check.mjs && node scripts/mobile-check.mjs && node scripts/campaign-check.mjs && node scripts/failure-check.mjs",
    "lint": "eslint src",
    "format": "prettier --write src index.html package.json",
    "format:check": "prettier --check src index.html package.json"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.46.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
